{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run typecheck*)",
      "Bash(yarn lint*)",
      "Bash(yarn test*)",
      "Bash(yarn build*)",
      "Bash(yarn typecheck*)",
      "Bash(mkdir -p .claude/_workspace*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/auto-pull.sh", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/guard-pretool.sh", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/notify.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "NOTIFIER_MESSAGE='응답 완료' bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/notify.sh", "timeout": 5 }
        ]
      }
    ]
  }
}
